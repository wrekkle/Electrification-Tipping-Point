lable <a href=\"https://new.calderdale.gov.uk/parking/car-parks-and-street-parking/car-parks?circuit=34&zone=3&town=brighouse&f%5B0%5D=localgov_directories_facets%3A143&page=0\">here</a>.</p>\n  <p>This data set includes the total number of charging sessions and the total kWh charged on a quarterly basis.</p>\n  <p>The Climate Change Dashboard is <a href=\"https://dataworks.calderdale.gov.uk/dashboards/climate-change/\">here</a></p>\n</dp-prose>", "num_resources": 0, "num_tags": 0, "organization": {"id": "8f45940b-a372-4709-9119-cf19ac249ede", "name": "calderdale-metropolitan-borough-council", "title": "Calderdale Metropolitan Borough Council", "type": "organization", "description": "", "image_url": "", "created": "2012-06-27T14:50:08.577384", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "8f45940b-a372-4709-9119-cf19ac249ede", "private": false, "state": "active", "title": "Electric Vehicle Charging Points", "type": "dataset", "url": "https://dataworks.calderdale.gov.uk/dataset/electric-vehicle-charging-points-2kyxd", "version": null, "extras": [{"key": "dcat_issued", "value": "2019-11-27T14:41:23.477Z"}, {"key": "dcat_modified", "value": "2026-07-07T14:09:00.000Z"}, {"key": "dcat_publisher_name", "value": "Calderdale Council"}, {"key": "guid", "value": "2kyxd"}, {"key": "language", "value": ""}, {"key": "harvest_object_id", "value": "561199a9-9897-4b73-a897-241a0d183c3a"}, {"key": "harvest_source_id", "value": "fb844ae9-98e5-4d92-8ee5-3df864a6cea5"}, {"key": "harvest_source_title", "value": "Calderdale Dataworks"}], "resources": [], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"creator_user_id": "60e687bf-a6d8-43e2-a50e-efab84b27952", "id": "6292cfb3-7796-47f0-89af-27329864c2eb", "isopen": false, "license_id": null, "license_title": null, "metadata_created": "2025-10-28T09:03:34.419841", "metadata_modified": "2026-09-25T11:39:04.755107", "name": "electric-vehicle-charging-site1", "notes": "<dp-prose>\n  <p>A Low Emission Neighbourhood (LEN) is an area-based scheme that includes a package of measures focused on reducing emissions (and promoting sustainable living more generally). A LEN is delivered by a borough with support from the Greater London Authority (Mayor's Air Quality Fund), Transport for London (TfL) and the local community or Business Improvement Districts for Business LENs. For more information please visit-<a href=\"https://www.london.gov.uk/what-we-do/environment/pollution-and-air-quality/mayors-air-quality-fund#acc-i-54331\" target=\"_blank\">https://www.london.gov.uk/what-we-do/environment/pollution-and-air-quality/mayors-air-quality-fund#acc-i-54331</a>.</p>\n</dp-prose>", "num_resources": 1, "num_tags": 0, "organization": {"id": "4fc67187-8f81-4eaa-8820-b18d0cbf1ff6", "name": "greater-london-authority", "title": "Greater London Authority", "type": "organization", "description": "", "image_url": "", "created": "2012-06-27T14:49:02.054509", "is_organization": true, "approval_status": "pending", "state": "active"}, "owner_org": "4fc67187-8f81-4eaa-8820-b18d0cbf1ff6", "private": false, "state": "active", "title": "Electric Vehicle Charging Site", "type": "dataset", "url": "https://data.london.gov.uk/dataset/electric-vehicle-charging-site-2lzpg", "version": null, "extras": [{"key": "dcat_issued", "value": "2019-07-23T11:24:02.000Z"}, {"key": "dcat_modified", "value": "2019-09-03T07:14:21.000Z"}, {"key": "dcat_publisher_name", "value": "GLA Environment Team"}, {"key": "guid", "value": "2lzpg"}, {"key": "language", "value": ""}, {"key": "harvest_object_id", "value": "43267388-9d67-4a82-a5d8-847ce6449412"}, {"key": "harvest_source_id", "value": "8f43c9d7-fe24-44a6-a4a4-9f4f77aa06f6"}, {"key": "harvest_source_title", "value": "London Datastore - GLA"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2026-09-25T11:39:04.805999", "description": "Geopackage of Rapid charging points\nFormat: geopackage (gpk