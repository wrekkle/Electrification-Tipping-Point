    "count_spaces": true,
    "count_punctuation": true,
    "implementation": "len(bytes.decode('utf-8', errors='replace').replace('\\r\\n', '\\n').replace('\\r', '\\n'))",
    "note": "同一文件在 CRLF 与 LF 下结果相同，因此换行风格不影响档位判定。"
  },
